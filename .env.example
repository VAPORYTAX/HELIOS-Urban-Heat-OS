HELIOS_ENV=development
HELIOS_LOG_LEVEL=INFO
HELIOS_API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://helios:helios@localhost:5432/helios
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com
FORTYGUARD_TIMEOUT_SECONDS=30
FORTYGUARD_POLL_INTERVAL_SECONDS=2
FORTYGUARD_MAX_POLL_SECONDS=120
FORTYGUARD_CACHE_TTL_SECONDS=900
FORTYGUARD_MAX_RETRIES=3
