:root {
  --bg: #07090b;
  --panel: rgba(14, 18, 22, 0.76);
  --panel2: rgba(20, 26, 31, 0.78);
  --line: rgba(255,255,255,.09);
  --text: #f4f7f6;
  --muted: #7e8a88;
  --acid: #d9ff53;
  --warm: #ff8a4c;
  --cyan: #6be3dd;
}
* { box-sizing: border-box; }
html, body { margin: 0; min-height: 100%; background: var(--bg); color: var(--text); }
body { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
button { font: inherit; }
.shell { min-height: 100vh; display: grid; grid-template-columns: 228px 1fr; background:
  radial-gradient(circle at 72% 12%, rgba(217,255,83,.07), transparent 26%),
  radial-gradient(circle at 38% 80%, rgba(107,227,221,.05), transparent 28%),
  #07090b; }
.rail { position: sticky; top: 0; height: 100vh; border-right: 1px solid var(--line); padding: 26px 18px; display: flex; flex-direction: column; background: rgba(5,7,9,.86); backdrop-filter: blur(18px); }
.mark { display: flex; align-items: center; gap: 11px; padding: 2px 5px 24px; }
.mark strong { display:block; letter-spacing:.16em; font-size:14px; }
.mark span { display:block; color:var(--muted); font-size:9px; letter-spacing:.19em; margin-top:4px; }
.sun { width:39px; height:39px; border:1px solid rgba(217,255,83,.35); border-radius:13px; display:grid; place-items:center; color:var(--acid); box-shadow:inset 0 0 20px rgba(217,255,83,.08); }
nav { display:flex; flex-direction:column; gap:5px; }
.nav { border:0; background:transparent; color:#8d9795; display:flex; gap:11px; align-items:center; padding:12px 13px; border-radius:11px; cursor:pointer; text-align:left; }
.nav:hover { color:white; background:rgba(255,255,255,.035); }
.nav.active { color:var(--acid); background:rgba(217,255,83,.075); box-shadow:inset 3px 0 var(--acid); }
.rail-bottom { margin-top:auto; border-top:1px solid var(--line); padding:18px 8px 4px; }
.eyebrow { color:#71807d; font-size:9px; letter-spacing:.22em; text-transform:uppercase; }
.secure { margin-top:9px; display:flex; align-items:center; gap:7px; font-size:12px; color:var(--acid); }
.micro { font-size:10px; color:#586462; margin-top:5px; }
.workspace { min-width:0; padding:28px 34px 22px; }
.topbar { display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; }
.topbar h1 { margin:7px 0 0; font-size:23px; font-weight:570; letter-spacing:-.02em; }
.status-pill { border:1px solid var(--line); border-radius:999px; padding:8px 12px; display:flex; align-items:center; gap:8px; color:#9da7a5; font-size:10px; letter-spacing:.12em; }
.dot { width:7px; height:7px; border-radius:999px; background:#cb5d4f; box-shadow:0 0 12px rgba(203,93,79,.55); }
.dot.good { background:var(--acid); box-shadow:0 0 12px rgba(217,255,83,.55); }
.hero { min-height:315px; border:1px solid var(--line); border-radius:24px; padding:38px 42px; display:grid; grid-template-columns:1.05fr .95fr; overflow:hidden; background:linear-gradient(140deg, rgba(255,255,255,.035), rgba(255,255,255,.012)); position:relative; }
.hero:after { content:""; position:absolute; inset:auto -10% -55% 35%; height:390px; background:radial-gradient(circle, rgba(217,255,83,.08), transparent 65%); pointer-events:none; }
.hero h2 { font-size:48px; line-height:.98; letter-spacing:-.055em; margin:16px 0 17px; font-weight:560; max-width:600px; }
.hero h2 em { font-style:normal; color:var(--acid); font-weight:480; }
.hero p { color:#8e9997; max-width:560px; line-height:1.65; font-size:13px; }
.hero-actions { display:flex; gap:10px; margin-top:24px; }
.primary,.ghost { border-radius:10px; padding:11px 15px; cursor:pointer; font-size:11px; letter-spacing:.04em; }
.primary { background:var(--acid); color:#101400; border:1px solid var(--acid); font-weight:700; }
.ghost { background:transparent; color:#c7cfcd; border:1px solid var(--line); }
.orbital { position:relative; display:grid; place-items:center; min-height:250px; }
.orbit { position:absolute; border:1px solid rgba(217,255,83,.15); border-radius:50%; }
.orbit-a { width:245px; height:245px; }
.orbit-b { width:170px; height:170px; border-color:rgba(107,227,221,.16); }
.core { width:92px; height:92px; border-radius:50%; border:1px solid rgba(217,255,83,.35); background:radial-gradient(circle at 40% 35%, rgba(217,255,83,.15), rgba(10,15,12,.9) 70%); display:flex; flex-direction:column; align-items:center; justify-content:center; color:var(--acid); box-shadow:0 0 70px rgba(217,255,83,.09); }
.core strong { font-size:20px; margin-top:3px; }
.core span { font-size:8px; letter-spacing:.17em; color:#87918e; }
.tag { position:absolute; color:#717d7a; font-size:8px; letter-spacing:.14em; background:#0b0e10; padding:5px 8px; border:1px solid var(--line); border-radius:999px; }
.t1 { top:22px; left:46%; } .t2 { right:10%; top:46%; } .t3 { bottom:20px; left:44%; } .t4 { left:9%; top:49%; }
.metrics { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin:14px 0; }
.metric { border:1px solid var(--line); border-radius:16px; padding:17px; background:var(--panel); display:flex; gap:12px; align-items:flex-start; }
.metric-icon { width:34px; height:34px; border-radius:10px; display:grid; place-items:center; color:var(--acid); background:rgba(217,255,83,.065); }
.metric span,.metric small { display:block; color:#75817f; font-size:9px; letter-spacing:.12em; text-transform:uppercase; }
.metric strong { display:block; margin:4px 0; font-size:19px; letter-spacing:-.03em; }
.metric small { text-transform:none; letter-spacing:0; font-size:10px; }
.grid { display:grid; grid-template-columns:1.55fr .75fr; gap:14px; }
.panel { border:1px solid var(--line); border-radius:18px; background:var(--panel); overflow:hidden; }
.panel-head { display:flex; align-items:center; justify-content:space-between; padding:18px 19px; border-bottom:1px solid var(--line); }
.panel-head h3 { margin:5px 0 0; font-size:15px; font-weight:560; }
.badge { font-size:8px; color:var(--cyan); border:1px solid rgba(107,227,221,.23); padding:5px 7px; border-radius:999px; letter-spacing:.13em; }
.map-shell { min-height:335px; position:relative; overflow:hidden; background:linear-gradient(180deg,#0b0e11,#090c0e); }
.mesh { position:absolute; inset:-30%; opacity:.16; transform:perspective(500px) rotateX(58deg) rotateZ(-17deg); background-image:linear-gradient(rgba(255,255,255,.16) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.16) 1px,transparent 1px); background-size:34px 34px; }
.heat { position:absolute; border-radius:50%; filter:blur(5px); opacity:.18; }
.h1 { width:180px;height:180px;left:20%;top:25%;background:var(--warm); }
.h2 { width:145px;height:145px;right:22%;top:18%;background:var(--acid); }
.h3 { width:110px;height:110px;right:32%;bottom:8%;background:var(--cyan); }
.city-label { position:absolute; left:22px; bottom:45px; font-size:10px; letter-spacing:.18em; color:#9ba5a2; }
.map-note { position:absolute; left:20px; right:20px; bottom:14px; display:flex; gap:7px; align-items:center; color:#64706e; font-size:10px; }
.stack { padding-bottom:7px; }
.stack-row { display:flex; justify-content:space-between; padding:15px 18px; border-bottom:1px solid rgba(255,255,255,.055); color:#aab2b0; font-size:11px; }
.stack-row b { color:#5d6765; font-size:9px; letter-spacing:.12em; }
.stack-row b.ok { color:var(--acid); }
footer { display:flex; justify-content:space-between; gap:20px; color:#4f5b58; font-size:9px; padding:18px 3px 0; letter-spacing:.04em; }
@media (max-width: 980px) {
  .shell { grid-template-columns:76px 1fr; }
  .mark div:last-child,.nav span,.rail-bottom { display:none; }
  .rail { padding:22px 12px; }
  .nav { justify-content:center; }
  .workspace { padding:22px 18px; }
  .hero { grid-template-columns:1fr; }
  .orbital { display:none; }
  .metrics { grid-template-columns:repeat(2,1fr); }
  .grid { grid-template-columns:1fr; }
}
