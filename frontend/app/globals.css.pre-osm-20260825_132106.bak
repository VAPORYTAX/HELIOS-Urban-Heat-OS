:root{--bg:#07090b;--panel:#0d1114;--panel2:#11171a;--line:rgba(255,255,255,.09);--text:#f4f7f6;--muted:#74807d;--acid:#d9ff53;--cyan:#67ded7;--bad:#ff765f}
*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}button{font:inherit}
.live-shell{min-height:100vh;padding:26px 32px 34px;background:radial-gradient(circle at 82% 0,rgba(217,255,83,.075),transparent 25%),radial-gradient(circle at 10% 72%,rgba(103,222,215,.045),transparent 24%),#07090b}
.live-top{display:flex;justify-content:space-between;align-items:center}.live-top h1{margin:6px 0 0;font-size:25px;letter-spacing:-.04em}.live-top h1 span{font-weight:400;color:#8d9895}.eyebrow{font-size:9px;letter-spacing:.2em;color:#697572;text-transform:uppercase}.live-actions{display:flex;gap:10px;align-items:center}.live-actions button,.mode-tabs button{color:#aab4b1;background:#0c1012;border:1px solid var(--line);border-radius:10px;padding:9px 12px;display:flex;gap:7px;align-items:center;cursor:pointer}.health{font-size:9px;letter-spacing:.14em;color:#9b706b;border:1px solid var(--line);border-radius:999px;padding:8px 11px;display:flex;gap:7px;align-items:center}.health i{width:6px;height:6px;background:var(--bad);border-radius:50%}.health.good{color:var(--acid)}.health.good i{background:var(--acid);box-shadow:0 0 12px rgba(217,255,83,.6)}
.truthbar{margin-top:20px;border:1px solid rgba(217,255,83,.16);background:rgba(217,255,83,.035);border-radius:12px;padding:11px 14px;display:flex;align-items:center;gap:9px;color:#aeb9b6;font-size:10px}.truthbar b{color:var(--acid);letter-spacing:.11em}.truthbar span{color:#75817e}.truthbar em{margin-left:auto;font-style:normal;color:#606c69;letter-spacing:.1em;font-size:8px}
.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:11px;margin:13px 0}.lk{border:1px solid var(--line);border-radius:15px;background:rgba(14,18,21,.8);padding:15px;display:flex;gap:11px}.lk>div{color:var(--acid)}.lk svg{width:18px}.lk span{font-size:9px;color:#78827f;text-transform:uppercase;letter-spacing:.11em}.lk strong,.lk small{display:block}.lk strong{font-size:19px;color:white;letter-spacing:-.03em;margin:4px 0}.lk small{font-size:9px;color:#5d6966;text-transform:none;letter-spacing:0}
.live-grid{display:grid;grid-template-columns:1.55fr .75fr;gap:12px}.atlas-card,.stack-card,.detail{border:1px solid var(--line);border-radius:17px;background:rgba(13,17,20,.86);overflow:hidden}.card-head{padding:16px 18px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between}.card-head h2{font-size:14px;margin:5px 0 0}.card-head>span{font-size:9px;color:var(--cyan)}
.cell-grid{min-height:305px;padding:18px;display:grid;grid-template-columns:repeat(4,1fr);gap:9px;background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);background-size:30px 30px}.cell{min-height:120px;border:1px solid rgba(217,255,83,.12);border-radius:14px;background:linear-gradient(145deg,rgba(217,255,83,.045),rgba(103,222,215,.018));color:#bdc6c3;text-align:left;padding:13px;cursor:pointer}.cell:hover{border-color:rgba(217,255,83,.36);transform:translateY(-1px)}.cell span,.cell small{display:block;font-size:9px;color:#71807c}.cell strong{display:block;font-size:27px;color:white;margin:11px 0 7px}.haz{height:3px;background:#19201f;margin-top:12px;border-radius:4px;overflow:hidden}.haz i{display:block;height:100%;background:var(--acid)}.atlas-foot{border-top:1px solid var(--line);padding:11px 16px;color:#65716e;font-size:9px;display:flex;gap:7px;align-items:center}
.lr{padding:14px 16px;border-bottom:1px solid rgba(255,255,255,.055);display:flex;justify-content:space-between;color:#9ba6a3;font-size:10px}.lr b{font-size:9px;color:var(--bad)}.lr b.ok{color:var(--acid)}
.mode-tabs{display:flex;gap:8px;margin:14px 0}.mode-tabs .on{color:var(--acid);border-color:rgba(217,255,83,.25);background:rgba(217,255,83,.055)}
.detail-grid{display:grid;grid-template-columns:1.55fr .75fr;gap:12px}.detail{padding:17px}.detail h3{font-size:14px;margin:5px 0 15px}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.fact{border:1px solid var(--line);border-radius:11px;padding:12px}.fact span{display:block;color:#697572;font-size:8px;text-transform:uppercase;letter-spacing:.12em}.fact b{display:block;margin-top:5px;font-size:12px;color:#cbd3d0;overflow-wrap:anywhere}.json{margin:0;max-height:320px;overflow:auto;color:#8fa5a0;font-size:10px;line-height:1.55;background:#090c0e;padding:13px;border-radius:10px;border:1px solid var(--line)}.allgood{display:flex;gap:9px;align-items:center;color:var(--acid);font-size:11px;padding:18px 0}.err{display:flex;gap:8px;color:var(--bad);font-size:9px;padding:9px 0;border-bottom:1px solid var(--line)}.err span b{display:block;color:#c7cecc;margin-bottom:3px}.empty{grid-column:1/-1;display:grid;place-items:center;color:#65716e;font-size:10px}
@media(max-width:1050px){.kpis{grid-template-columns:repeat(2,1fr)}.live-grid,.detail-grid{grid-template-columns:1fr}.cell-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.live-shell{padding:18px}.live-top{align-items:flex-start;gap:15px}.truthbar span,.truthbar em{display:none}.kpis{grid-template-columns:1fr}.cell-grid{grid-template-columns:1fr}.mode-tabs{overflow:auto}}
